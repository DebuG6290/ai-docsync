# For an invite-only workspace. Never commit the real secrets.toml.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
SARVAM_API_KEY = "REPLACE_ME"
GITHUB_APP_ID = "REPLACE_ME"
GITHUB_PRIVATE_KEY = """REPLACE_WITH_PEM"""
DOCSYNC_AUTH_MODE = "oidc"
DOCSYNC_HOSTED = "true"
DOCSYNC_CHAT_DAILY_LIMIT = 30
DOCSYNC_MODEL_ACTION_DAILY_LIMIT = 20
DOCSYNC_REPOSITORY_DAILY_LIMIT = 200
DOCSYNC_ACCESS_POLICY = '''
{"version":1,"members":[
  {"issuer":"https://accounts.google.com","subject":"REPLACE_WITH_YOUR_SUB","admin":true},
  {"issuer":"https://accounts.google.com","subject":"REPLACE_WITH_TEAMMATE_SUB","repositories":{"YOUR_OWNER/YOUR_REPO":"reader"}}
]}
'''
# Optional bootstrap; otherwise connect the first repository after signing in.
DOCSYNC_REPOSITORY = ""
DOCSYNC_MONITORED_BRANCH = "main"

[auth]
redirect_uri = "https://YOUR_APP/oauth2callback"
cookie_secret = "REPLACE_WITH_A_CRYPTOGRAPHICALLY_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
client_id = "REPLACE_WITH_PROVIDER_CLIENT_ID"
client_secret = "REPLACE_WITH_PROVIDER_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
SARVAM_MODEL = "sarvam-105b"
